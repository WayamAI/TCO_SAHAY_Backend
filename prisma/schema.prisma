generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  ANALYST
  VIEWER
}

model Organization {
  id         String   @id @default(uuid())
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships Membership[]
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  deactivatedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships   Membership[]
  refreshTokens RefreshToken[]
}

model Membership {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           Role
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Fleet {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  locomotives Locomotive[]

  @@index([organizationId])
}

model OperatingProfile {
  id                        String  @id @default(uuid())
  organizationId            String?
  name                      String
  fuelMultiplier            Float
  wearMultiplier            Float
  maintenanceFreqMultiplier Float
  failureProbMultiplier     Float
  annualKm                  Float
  annualHours               Float
  description               String

  locomotives Locomotive[]

  @@index([organizationId])
}

model Locomotive {
  id                 String    @id @default(uuid())
  organizationId     String
  fleetId            String
  operatingProfileId String
  model              String
  manufacturer       String
  type               String
  horsepower         Float
  purchaseCost       Float
  commissionYear     Int
  plannedLifeYears   Int
  annualKm           Float
  annualHours        Float
  fuelType           String
  fuelCostPerUnit    Float
  status             String
  currentHealthScore Float     @default(100)
  availabilityPct    Float     @default(100)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  fleet                Fleet                 @relation(fields: [fleetId], references: [id])
  operatingProfile     OperatingProfile      @relation(fields: [operatingProfileId], references: [id])
  systems              SystemNode[]
  maintenanceSchedules MaintenanceSchedule[]
  costRecords          CostRecord[]

  @@index([organizationId, fleetId])
}

model SystemNode {
  id             String @id @default(uuid())
  organizationId String
  locomotiveId   String
  name           String
  icon           String
  criticality    String
  healthScore    Float  @default(100)

  locomotive Locomotive @relation(fields: [locomotiveId], references: [id])
  assemblies Assembly[]

  @@index([organizationId, locomotiveId])
}

model Assembly {
  id             String @id @default(uuid())
  organizationId String
  systemNodeId   String
  name           String

  systemNode SystemNode  @relation(fields: [systemNodeId], references: [id])
  components Component[]

  @@index([organizationId, systemNodeId])
}

model Component {
  id                 String    @id @default(uuid())
  organizationId     String
  assemblyId         String
  name               String
  purchaseCost       Float
  replacementCost    Float
  lifeYears          Float
  pmTriggerMonths    Float?
  pmTriggerKm        Float?
  pmTriggerHours     Float?
  mtbfHours          Float
  weibullBeta        Float
  weibullEta         Float
  mttrHours          Float
  warrantyYears      Float
  laborCostPct       Float
  failureImpact      String
  category           String
  currentHours       Float     @default(0)
  downtimeCostPerDay Float
  healthScore        Float     @default(100)
  deletedAt          DateTime?

  assembly         Assembly               @relation(fields: [assemblyId], references: [id])
  dependsOn        ComponentDependency[]  @relation("DependsOn")
  dependents       ComponentDependency[]  @relation("DependsOnTarget")

  @@index([organizationId, assemblyId])
}

model ComponentDependency {
  id                    String @id @default(uuid())
  componentId           String
  dependsOnComponentId  String

  component          Component @relation("DependsOn", fields: [componentId], references: [id], onDelete: Cascade)
  dependsOnComponent  Component @relation("DependsOnTarget", fields: [dependsOnComponentId], references: [id], onDelete: Cascade)

  @@unique([componentId, dependsOnComponentId])
}

enum MaintenanceType {
  PREVENTIVE
  OVERHAUL
  REBUILD
}

model MaintenanceSchedule {
  id               String           @id @default(uuid())
  organizationId   String
  locomotiveId     String
  name             String
  triggerMonths    Float?
  triggerKm        Float?
  triggerHours     Float?
  rule             String
  laborHours       Float
  laborRatePerHour Float
  partsEstimate    Float
  type             MaintenanceType
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  locomotive Locomotive @relation(fields: [locomotiveId], references: [id])

  @@index([organizationId, locomotiveId])
}

enum CostCategory {
  CAPEX
  MAINTENANCE
  CONSUMABLE
  LABOR
  FAILURE
  WARRANTY
  FUEL
  DOWNTIME
}

model CostRecord {
  id             String       @id @default(uuid())
  organizationId String
  locomotiveId   String
  year           Int
  category       CostCategory
  amount         Float
  createdAt      DateTime     @default(now())

  locomotive Locomotive @relation(fields: [locomotiveId], references: [id])

  @@index([organizationId, locomotiveId, year, category])
}
